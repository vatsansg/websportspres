# Local development only. In Azure, these are set as App Service Application Settings -
# never as a .env file. No secrets belong in this file: MySQL/Storage auth is Managed
# Identity (locally: your own `az login` session, via DefaultAzureCredential).

PORT=8080
NODE_ENV=development

MYSQL_HOST=mysql-sportspres-assetmgmt.mysql.database.azure.com
MYSQL_AAD_USER=vatsan@worldtabletennis.com
MYSQL_DATABASE=assetmgmt_dev

STORAGE_ACCOUNT_URL=https://sasportspresentation.blob.core.windows.net
STORAGE_TEMPLATES_CONTAINER=templates

# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=

# Filled in once WTT IT completes the Azure AD app registration (see workflow.md).
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

MAX_VIDEO_UPLOAD_MB=100
CHANGE_LOG_EMAIL_RECIPIENT=wtt-naiteam@worldtabletennis.com

CORS_ORIGIN=http://localhost:4200
